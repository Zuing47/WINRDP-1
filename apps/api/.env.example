# ─────────────────────────────────────────────────────────────────
# PriceAI API — variáveis de ambiente
# Copie para .env e ajuste conforme o ambiente.
# ─────────────────────────────────────────────────────────────────

# HTTP
PORT=3001
NODE_ENV=development
# Origem permitida no CORS (frontend)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (obrigatório)
DATABASE_URL=postgresql://priceai:priceai@localhost:5432/priceai

# Redis (opcional — sem Redis o app usa cache em memória e executa
# os jobs de fila de forma síncrona/inline, ideal para demo local)
REDIS_URL=redis://localhost:6379

# JWT — access token expira em 15min, refresh em 30 dias
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# S3 / MinIO (opcional — sem S3 o presign devolve URLs locais fake p/ dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=priceai
S3_SECRET_KEY=priceai-secret
S3_BUCKET=priceai-photos
# Força path-style (necessário para MinIO)
S3_FORCE_PATH_STYLE=true

# Google OAuth (opcional — sem GOOGLE_CLIENT_ID o endpoint /auth/google
# responde 501 com mensagem clara)
GOOGLE_CLIENT_ID=

# Provedores de IA — lista em cascata separada por vírgula.
# Valores: openai | anthropic | gemini | local | mock
# Sem nenhuma chave configurada o MockAiProvider (determinístico) é usado.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Ollama local (LLaVA para visão)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava

# Cache de busca de mercado (segundos) — 6h
MARKET_CACHE_TTL=21600
